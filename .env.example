# Copy to .env for a private production instance. Never commit actual values.
APP_MODE=live
APP_URL=https://os.example.com
OWNER_EMAIL=
SESSION_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"
INTEGRATION_TOKEN="REPLACE_WITH_YOUR_OWN_VALUE"
DATABASE_URL=postgresql://ai_os:CHANGE_ME@db:5432/ai_os
DIRECT_URL=postgresql://ai_os:CHANGE_ME@db:5432/ai_os
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"
MAIL_ENABLED=false
AI_ENABLED=false
AI_MODEL=gpt-6.1-sol
AI_REASONING=medium
AI_CODEX_BINARY=codex
AI_CODEX_HOME=/home/runner/.codex
AI_DAILY_LIMIT=25
AI_TIMEOUT_MS=300000
SCHEDULER_ENABLED=false
N8N_DISPATCH_URL=
N8N_DISPATCH_TOKEN=
DATA_DIR=/data
BACKUP_SECRET="REPLACE_WITH_YOUR_OWN_VALUE"
OBSIDIAN_EXPORT_DIR=
